# LocalLens environment variables
# Copy to backend/.env (and frontend/.env.local for NEXT_PUBLIC_* only).
# Never put real credentials in this file or commit them to Git.

# Provider mode: "mock" | "live"
# live requires both API keys below and does NOT fall back to mock.
PROVIDER_MODE=mock

# Kakao Local REST API (required when PROVIDER_MODE=live)
# From https://developers.kakao.com/ — REST API key with Local search enabled
KAKAO_REST_API_KEY=

# Google Places API (required when PROVIDER_MODE=live)
# From Google Cloud Console — enable Places API (Find Place + Place Details)
GOOGLE_PLACES_API_KEY=

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Frontend (Next.js) — public API base URL (no secrets)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Database (for future persistence; not required for MVP search)
DATABASE_URL=postgresql+asyncpg://locallens:locallens@localhost:5432/locallens
