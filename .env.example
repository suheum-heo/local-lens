# LocalLens environment variables
# Copy to backend/.env and frontend/.env.local as needed.
# Never put real credentials in this file.

# Provider mode: "mock" | "live"
PROVIDER_MODE=mock

# Kakao Local REST API (required when PROVIDER_MODE=live)
KAKAO_REST_API_KEY=

# Google Places API (required when PROVIDER_MODE=live)
GOOGLE_PLACES_API_KEY=

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Frontend (Next.js) — public API base URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Database (for future persistence; not required for MVP mock mode)
DATABASE_URL=postgresql+asyncpg://locallens:locallens@localhost:5432/locallens
